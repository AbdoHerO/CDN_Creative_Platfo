    "@prisma/client": "^7.10.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "file-type": "^22.3.0",
