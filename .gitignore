# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# real .env.dev / .env.prod stay local; commit only the templates
!.env.dev.example
!.env.prod.example

# generated Prisma client (rebuilt by `prisma generate` / postinstall)
/src/generated

# pdf.js assets copied by scripts/copy-pdfjs.mjs
/public/pdfjs

# test artifacts
/test-results
/playwright-report
/e2e/.auth
/e2e/.fixtures
