# ─────────────────────────────────────────────────────────────────────────────
# Creative Management Platform — development configuration (.env.dev)
# Development environment, loaded by npm run dev, npm run worker, the scripts and
# Prisma (any NODE_ENV other than production). Variables already set win.
# Use ENV_FILE=<file> to load a different file. Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string (PostgreSQL 14+; the pg_trgm extension is created by migrations).
DATABASE_URL="postgresql://cmp:cmp_dev_password@127.0.0.1:5432/cmp?schema=public"
# Optional: connection pool size per process (default 10).
# DATABASE_POOL_SIZE=10

# Public base URL of the web app (used for CSRF origin checks and bucket CORS).
APP_URL="http://localhost:3000"
# Set to "true" when running behind a reverse proxy / load balancer that sets X-Forwarded-* headers.
TRUST_PROXY="false"
# Session lifetime in days (sliding).
SESSION_TTL_DAYS=7

# ── Object storage: RustFS (S3-compatible API) ───────────────────────────────
# S3 API endpoint of the RustFS server. Browsers upload and download through
# presigned URLs on this host, so it must be reachable from users' browsers too.
URL_RUSTFS="http://127.0.0.1:9000"
# Private bucket that holds originals, thumbnails and retained ZIP archives.
BUCKET_NAME="cmp-dev"
# RustFS access key / secret key with read & write access to the bucket.
ACCESS_KEY=""
SECRET_KEY=""
# Optional: signing region, must match the server's RUSTFS_REGION (default us-east-1).
# S3_REGION="us-east-1"
# Extra origins allowed by `npm run storage:setup` (comma separated).
STORAGE_CORS_EXTRA_ORIGINS=""


# ── Uploads ──────────────────────────────────────────────────────────────────
# Hard per-file limit (MB). Admins can lower it in Settings, never raise it above this.
UPLOAD_MAX_FILE_SIZE_MB=20480
# Multipart part size (MB, min 5) and threshold above which multipart is used.
UPLOAD_PART_SIZE_MB=16
UPLOAD_MULTIPART_THRESHOLD_MB=32
# Abandoned upload sessions are aborted after this many hours.
UPLOAD_SESSION_TTL_HOURS=48

# ── ZIP import limits ────────────────────────────────────────────────────────
ZIP_MAX_ENTRIES=5000
ZIP_MAX_UNCOMPRESSED_MB=102400
ZIP_MAX_COMPRESSION_RATIO=200

# ── Signed URLs ──────────────────────────────────────────────────────────────
# Lifetime of inline preview URLs (seconds) and download URLs (seconds).
SIGNED_URL_TTL_SECONDS=14400
DOWNLOAD_URL_TTL_SECONDS=300

# ── Background worker ────────────────────────────────────────────────────────
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=2000
# Scratch space for media processing (defaults to the OS temp dir). Needs room for your largest file.
WORKER_TMP_DIR=""
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
PDFTOPPM_PATH="pdftoppm"
PDFINFO_PATH="pdfinfo"

# ── Seed (first run) ─────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL="admin@example.com"
# Leave empty to generate a temporary password (printed once, must be changed on first login).
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Platform Admin"
# Development only: create demo manager/creator/viewer users and sample campaigns.
SEED_DEMO_USERS="true"
SEED_DEMO_PASSWORD=""
